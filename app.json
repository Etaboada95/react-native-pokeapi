{
    "expo": {
        "name": "PokeApi",
        "slug": "react-native-pokeapi",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "reactnativepokeapi",
        "userInterfaceStyle": "automatic",
        "ios": {
            "icon": "./assets/icon.png"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/icon.png",
                "backgroundImage": "./assets/images/icon.png",
                "monochromeImage": "./assets/images/icon.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "com.etaboada.reactnativepokeapi"
        },
        "web": {
            "output": "server",
            "favicon": "./assets/images/favicon.png",
            "bundler": "metro"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#f8f5ee",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 150
                }
            ],
            "expo-image",
            [
                "expo-font",
                {
                    "fonts": [
                        "./assets/fonts/Pixelify_Sans/PixelifySans-Regular.ttf",
                        "./assets/fonts/Pixelify_Sans/PixelifySans-Medium.ttf",
                        "./assets/fonts/Pixelify_Sans/PixelifySans-SemiBold.ttf",
                        "./assets/fonts/Pixelify_Sans/PixelifySans-Bold.ttf"
                    ]
                }
            ],
            "@react-native-vector-icons/feather",
            [
                "expo-build-properties",
                {
                    "android": {
                        "cmakeVersion": "3.31.6"
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
